VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN del_gui_repeat ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 2000 2000 ) ;
TRACKS Y 0 DO 51 STEP 40 LAYER M2 ;
COMPONENTS 0 ;
END COMPONENTS
PINS 0 ;
END PINS
NETS 3 ;
  - n1 + ROUTED M2 ( 500 1000 ) ( 700 1000 ) ;
  - n2 + ROUTED M2 ( 780 1000 ) ( 980 1000 ) ;
  - n3 + ROUTED M2 ( 520 1040 ) ( 720 1040 ) ;
END NETS
END DESIGN
